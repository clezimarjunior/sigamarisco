---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../../site';
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const cats = [...new Set(posts.map((p) => p.data.category))].sort();
---
<Base title="Blog de viagem — todos os artigos | Siga Marisco" description="Todos os roteiros, guias e reviews do Siga Marisco: Brasil, Bolívia, Peru, Colômbia, Argentina e dicas de viagem.">
  <section class="section">
    <div class="wrap">
      <div class="section-head"><h1 style="font-size:clamp(32px,4.4vw,46px)">Todos os artigos</h1></div>
      <nav class="chips" aria-label="Destinos">
        <a class="chip" href="/blog" aria-current="page">Todos</a>
        {cats.map((c) => <a class="chip" href={`/categoria/${slugify(c)}`}>{c}</a>)}
      </nav>
      <div class="grid">{posts.map((p, i) => <PostCard post={p} eager={i === 0} />)}</div>
    </div>
  </section>
</Base>
