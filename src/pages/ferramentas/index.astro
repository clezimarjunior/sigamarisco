---
import Base from '../../layouts/Base.astro';
import SocialBand from '../../components/SocialBand.astro';
import { SITE, TOOLS, ORG_ID } from '../../site';

const title = 'Ferramentas de viagem grátis | Siga Marisco';
const description = 'Ferramentas grátis para planejar sua viagem: calculadora Schengen da regra 90/180 e outros apps simples feitos pelo Siga Marisco. Use sem cadastro.';
const url = `${SITE.url}/ferramentas`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Ferramentas de viagem',
    description,
    url,
    inLanguage: 'pt-BR',
    isPartOf: { '@id': `${SITE.url}/#website`, '@type': 'WebSite', name: SITE.name, url: SITE.url },
    publisher: { '@id': ORG_ID },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: TOOLS.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, url: `${url}/${t.slug}` })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Ferramentas', item: url },
    ],
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="wrap tools-hub">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / Ferramentas</nav>
    <span class="eyebrow eyebrow-dark">Grátis e sem cadastro</span>
    <h1>Ferramentas de viagem</h1>
    <p class="hub-lead">Calculadoras e apps simples para resolver aquelas dúvidas que aparecem no planejamento da viagem. Tudo roda no seu navegador: nada do que você digita é enviado para a gente.</p>

    <div class="tool-grid">
      {TOOLS.map((t) => (
        <a class="tool-card" href={`/ferramentas/${t.slug}`}>
          <span class="tool-emoji" aria-hidden="true">{t.emoji}</span>
          <h2>{t.name}</h2>
          <p>{t.description}</p>
          <span class="link-arrow">Usar agora →</span>
        </a>
      ))}
      <div class="tool-card tool-soon" aria-hidden="true">
        <span class="tool-emoji">🧳</span>
        <h2>Em breve</h2>
        <p>Novas ferramentas para planejar a viagem estão a caminho. Tem uma ideia? Mande pra gente no contato.</p>
      </div>
    </div>
  </div>
  <div class="wrap" style="margin-top:56px"><SocialBand /></div>
</Base>

<style>
  .tools-hub { padding-top: 40px; }
  .tools-hub h1 { font-size: clamp(34px, 4.6vw, 50px); margin: 10px 0 14px; }
  .eyebrow-dark { color: var(--orange); }
  .hub-lead { font-size: 19px; color: var(--muted); max-width: 680px; margin: 0 0 36px; }
  .tool-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; }
  .tool-card { display: flex; flex-direction: column; gap: 10px; padding: 28px; border-radius: var(--radius); background: #fff; box-shadow: var(--shadow); text-decoration: none; color: inherit; transition: transform .2s ease, box-shadow .2s ease; }
  a.tool-card:hover { transform: translateY(-4px); box-shadow: 0 2px 4px rgba(2,48,71,.06), 0 16px 40px rgba(2,48,71,.14); }
  .tool-card h2 { font-size: 23px; }
  .tool-card p { margin: 0; color: var(--muted); font-size: 16px; flex: 1; }
  .tool-emoji { font-size: 34px; line-height: 1; }
  .tool-soon { background: var(--bg-soft); box-shadow: none; border: 1px dashed var(--line); }
</style>
