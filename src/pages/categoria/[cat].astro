---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { slugify, stateUrl, CATEGORY_META, CATEGORY_INTRO } from '../../site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  const cats = [...new Set(posts.map((p) => p.data.category))];
  return cats.map((c) => ({
    params: { cat: slugify(c) },
    props: { name: c, posts: posts.filter((p) => p.data.category === c).sort((a, b) => +b.data.date - +a.data.date) },
  }));
}
const { name, posts } = Astro.props;
const all = await getCollection('blog', (p) => !p.data.draft);
const cats = [...new Set(all.map((p) => p.data.category))].sort();
const states = name === 'Brasil' ? [...new Set(posts.map((p) => p.data.state).filter((s): s is string => !!s))].sort((a, b) => a.localeCompare(b, 'pt-BR')) : [];
const title = name === 'Informação' ? 'Dicas de viagem' : `${name}: roteiros e dicas de viagem`;
const intro = CATEGORY_INTRO[name] ?? [];
const meta = CATEGORY_META[name] ?? { title: `${title} | Siga Marisco`, description: `Artigos do Siga Marisco sobre ${name}: o que fazer, quanto custa e dicas de quem já foi.` };
---
<Base title={meta.title} description={meta.description}>
  <section class="section">
    <div class="wrap">
      <div class="section-head"><h1 style="font-size:clamp(32px,4.4vw,46px)">{title}</h1></div>
      {intro.length > 0 && <div class="cat-intro">{intro.map((p) => <p>{p}</p>)}</div>}
      <nav class="chips" aria-label="Destinos">
        <a class="chip" href="/blog">Todos</a>
        {cats.map((c) => <a class="chip" href={`/categoria/${slugify(c)}`} aria-current={c === name ? 'page' : undefined}>{c}</a>)}
      </nav>
      {states.length > 0 && (
        <nav class="chips" aria-label="Estados do Brasil">
          <span class="list-title" style="margin:0 6px 0 0;align-self:center">Por estado:</span>
          {states.map((s) => <a class="chip" href={stateUrl(s)}>{s}</a>)}
        </nav>
      )}
      <h2 class="list-title">{posts.length === 1 ? 'Post' : `Os ${posts.length} posts`} sobre {name === 'Informação' ? 'planejamento de viagem' : name}</h2>
      <div class="grid">{posts.map((p) => <PostCard post={p} />)}</div>
    </div>
  </section>
</Base>
