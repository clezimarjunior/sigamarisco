---
import { SITE } from '../site';
import Img from './Img.astro';
import SocialIcons from './SocialIcons.astro';
---
<section class="band">
  <div style="position:relative;z-index:1">
    <h2>Acompanhe nossas aventuras</h2>
    <p>Vídeos dos roteiros no YouTube e os bastidores das viagens no Instagram, TikTok e Kwai.</p>
    <SocialIcons variant="light" />
  </div>
  <div class="band-actions">
    <a class="btn btn-orange" href={SITE.youtube} target="_blank" rel="noopener">Inscreva-se no YouTube</a>
    <a class="btn btn-ghost" href={SITE.instagram} target="_blank" rel="noopener">@sigamarisco</a>
  </div>
  <Img class="star" src="/brand/star.svg" alt="" decorative width="200" height="200" />
</section>
