---
import type { CollectionEntry } from 'astro:content';
import { fmtDate } from '../site';
interface Props { post: CollectionEntry<'blog'>; featured?: boolean; eager?: boolean }
const { post, featured = false, eager = false } = Astro.props;
const d = post.data;
---
<a href={`/blog/${post.id}`} class={featured ? 'featured' : 'card'}>
  <div class="card-img">
    <img src={featured ? d.cover : (d.thumb ?? d.cover)} alt={d.title} loading={eager ? 'eager' : 'lazy'} decoding="async" width="800" height="600" />
  </div>
  <div class="card-body">
    <span class="cat">{d.category}</span>
    <h3>{d.title}</h3>
    <p>{d.description}</p>
    <div class="meta">
      <img src="https://cdn.prod.website-files.com/64f5f9def2005cf7ecf3b0fa/650068f06fe95c50f40d6057_marina-p-500.png" alt="" class="avatar" width="30" height="30" loading="lazy" />
      <span>{d.author} · {fmtDate(d.date)}</span>
    </div>
  </div>
</a>
