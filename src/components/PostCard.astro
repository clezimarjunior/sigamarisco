---
import type { CollectionEntry } from 'astro:content';
import { fmtDate, authorNames, postAuthors } from '../site';
import Img from './Img.astro';
interface Props { post: CollectionEntry<'blog'>; featured?: boolean; eager?: boolean; /** nível do título do card, conforme a página */ headingLevel?: 2 | 3 }
const { post, featured = false, eager = false, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const d = post.data;
---
<a href={`/blog/${post.id}`} class={featured ? 'featured' : 'card'}>
  <div class="card-img">
    <Img src={featured ? d.cover : (d.thumb ?? d.cover)} alt={d.title} layout={featured ? 'featured' : 'card'} priority={eager} />
  </div>
  <div class="card-body">
    <span class="cat">{d.category}</span>
    <Heading class="card-title">{d.title}</Heading>
    <p>{d.description}</p>
    <div class="meta">
      <span class="avatars">{postAuthors(d).map((a) => <Img src={a.avatar} alt={a.name} class="avatar" width="30" height="30" loading="lazy" />)}</span>
      <span>{authorNames(d)} · {fmtDate(d.date)}</span>
    </div>
  </div>
</a>
