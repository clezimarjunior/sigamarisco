---
import type { CollectionEntry } from 'astro:content';
import { fmtDate } from '../site';
import Img from './Img.astro';
interface Props { post: CollectionEntry<'blog'>; featured?: boolean; eager?: boolean }
const { post, featured = false, eager = false } = Astro.props;
const d = post.data;
---
<a href={`/blog/${post.id}`} class={featured ? 'featured' : 'card'}>
  <div class="card-img">
    <Img src={featured ? d.cover : (d.thumb ?? d.cover)} alt={d.title} layout={featured ? 'featured' : 'card'} priority={eager} />
  </div>
  <div class="card-body">
    <span class="cat">{d.category}</span>
    <h3>{d.title}</h3>
    <p>{d.description}</p>
    <div class="meta">
      <Img src="/images/brand/marina-thumb.webp" alt={d.author} class="avatar" width="30" height="30" loading="lazy" />
      <span>{d.author} · {fmtDate(d.date)}</span>
    </div>
  </div>
</a>
