---
import { SITE } from '../site';
---
<section class="band">
  <div style="position:relative;z-index:1">
    <h2>Receba conteúdos exclusivos</h2>
    <p>Entre na nossa comunidade no WhatsApp: roteiros novos, promoções de passagens e novidades toda semana.</p>
  </div>
  <div class="band-actions">
    <a class="btn btn-orange" href={SITE.whatsapp} target="_blank" rel="noopener">Entrar na comunidade</a>
    <a class="btn btn-ghost" href={SITE.instagram} target="_blank" rel="noopener">@sigamarisco</a>
  </div>
  <img class="star" src="/brand/star.svg" alt="" width="200" height="200" />
</section>
